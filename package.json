{
  "name": "streamdeck-posthog",
  "version": "0.1.0",
  "description": "Show live PostHog insight values on your Elgato Stream Deck.",
  "author": "OG Innovations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OGInnovations/streamdeck-posthog.git"
  },
  "homepage": "https://github.com/OGInnovations/streamdeck-posthog#readme",
  "bugs": {
    "url": "https://github.com/OGInnovations/streamdeck-posthog/issues"
  },
  "type": "module",
  "private": true,
  "streamDeck": {
    "uuid": "io.ogin.streamdeck.posthog"
  },
  "scripts": {
    "build": "rollup -c",
    "pack": "npm run build && streamdeck pack io.ogin.streamdeck.posthog.sdPlugin --output dist --force",
    "validate": "streamdeck validate io.ogin.streamdeck.posthog.sdPlugin",
    "dev": "SD_VARIANT=dev rollup -c -w --watch.onEnd=\"streamdeck restart io.ogin.streamdeck.posthog.dev\"",
    "dev:build": "SD_VARIANT=dev rollup -c",
    "dev:link": "npm run dev:build && streamdeck link io.ogin.streamdeck.posthog.dev.sdPlugin && streamdeck restart io.ogin.streamdeck.posthog.dev",
    "dev:unlink": "streamdeck unlink io.ogin.streamdeck.posthog.dev",
    "dev:validate": "npm run dev:build && streamdeck validate io.ogin.streamdeck.posthog.dev.sdPlugin",
    "test": "node --import tsx --experimental-test-module-mocks --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2"
  },
  "devDependencies": {
    "@elgato/cli": "^1.9.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^22.0.0",
    "rollup": "^4.24.0",
    "tslib": "^2.8.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0"
  }
}
