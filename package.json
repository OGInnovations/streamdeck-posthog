{
  "name": "streamdeck-posthog",
  "version": "0.1.0",
  "description": "Show live PostHog insight values on your Elgato Stream Deck.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart io.ogin.streamdeck.posthog\"",
    "validate": "streamdeck validate io.ogin.streamdeck.posthog.sdPlugin",
    "pack": "npm run build && streamdeck pack io.ogin.streamdeck.posthog.sdPlugin --output dist --force",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2"
  },
  "devDependencies": {
    "@elgato/cli": "^1.9.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^22.0.0",
    "rollup": "^4.24.0",
    "tslib": "^2.8.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0"
  }
}
